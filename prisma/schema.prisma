generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

// ─────────────────────────────────────────────────────────────
// AUTH (NextAuth Credentials, JWT sessions, email + password only)
// No Session / Account models: Credentials provider forces JWT sessions.
// In the `jwt` callback re-check isActive / role / lockedUntil and compare
// passwordChangedAt with the token's iat to invalidate old tokens.
// ─────────────────────────────────────────────────────────────

/// Pre-register emails with a specific role so they receive it on first registration.
/// Apply the role only AFTER the email has been verified.
/// Always store and compare emails in lowercase.
model SpecialUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      UserRole  @default(FACULTY)
  createdAt DateTime  @default(now()) @map("created_at")
  /// Set when the role was applied to a registered user
  appliedAt DateTime? @map("applied_at")

  @@map("special_users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// SHA-256 of the token sent by email. Never store the raw token.
  tokenHash String    @unique @map("token_hash")
  expires   DateTime
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// SHA-256 of the token sent by email. Never store the raw token.
  tokenHash String    @unique @map("token_hash")
  expires   DateTime
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("password_reset_tokens")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  /// Always lowercase before write and lookup
  email               String    @unique
  emailVerified       DateTime? @map("email_verified")
  /// bcrypt/argon2 hash only
  password            String
  role                UserRole  @default(STUDENT)
  profileCompleted    Boolean   @default(false)

  // Account security / lifecycle
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  passwordChangedAt   DateTime? @map("password_changed_at")
  /// Soft delete. Author and bill relations use Restrict, so anonymize/soft-delete users instead of hard-deleting.
  deletedAt           DateTime? @map("deleted_at")

  // Profile
  image               String?
  coverImage          String?
  bio                 String?
  department          String?
  phone               String?
  institution         String?
  linkedinLink        String?
  githubLink          String?
  portfolioLink       String?
  resumeLink          String?
  skills              String[]

  // Student fields
  enrollmentNo        String?
  degree              String?
  currentYear         Int?
  currentSemester     Int?
  graduationYear      Int?

  // Faculty fields
  designation         String?
  yearsOfExperience   Int?
  areasOfExpertise    String[]
  researchInterests   String[]
  orcidId             String?

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  achievements            Achievement[]                @relation("userAchievements")
  studentBookChapters     BookChapterStudentAuthor[]   @relation("studentAuthors")
  facultyBookChapters     BookChapterTeacherAuthor[]   @relation("facultyAuthors")
  certification           Certificate[]                @relation("userCertificates")
  studentConferences      ConferenceStudentAuthor[]    @relation("studentConferenceAuthors")
  facultyConferences      ConferenceTeacherAuthor[]    @relation("facultyConferenceAuthors")
  studentCopyrights       CopyrightStudentAuthor[]     @relation("studentCopyrightAuthors")
  facultyCopyrights       CopyrightTeacherAuthor[]     @relation("facultyCopyrightAuthors")
  linkedVerifications     FacultyVerificationRequest[] @relation("linkedVerifications")
  verificationRequests    FacultyVerificationRequest[] @relation("verificationRequests")
  overriddenVerifications FacultyVerificationRequest[] @relation("verificationOverrides")
  fdp                     FDP[]                        @relation("userFDPs")
  bills                   GrantInBill[]
  studentGrantIns         GrantInStudentAuthor[]       @relation("studentGrantInAuthors")
  facultyGrantIns         GrantInTeacherAuthor[]       @relation("facultyGrantInAuthors")
  studentJournals         JournalStudentAuthor[]       @relation("studentJournalAuthors")
  facultyJournals         JournalTeacherAuthor[]       @relation("facultyJournalAuthors")
  notifications           Notification[]
  studentPatents          PatentStudentAuthor[]        @relation("studentPatentAuthors")
  facultyPatents          PatentTeacherAuthor[]        @relation("facultyPatentAuthors")

  @@unique([institution, enrollmentNo])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// BOOK CHAPTERS
// ─────────────────────────────────────────────────────────────

model BookChapter {
  id                String                     @id @default(cuid())
  title             String
  abstract          String?
  imageUrl          String?
  documentUrl       String?
  bookChapterStatus BookchapterStatus          @default(SUBMITTED)
  teacherStatus     TeacherStatus              @default(UPLOADED)
  isbnIssn          String?
  registrationFees  Decimal?                   @db.Decimal(12, 2)
  reimbursement     Decimal?                   @db.Decimal(12, 2)
  isPublic          Boolean                    @default(false)
  updateComment     String?
  keywords          String[]
  doi               String?                    @unique
  publicationDate   DateTime?
  publisher         String?
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  studentAuthors    BookChapterStudentAuthor[] @relation("studentAuthors")
  facultyAuthors    BookChapterTeacherAuthor[] @relation("facultyAuthors")
  grantMappings     GrantInMapping[]

  @@index([isPublic, bookChapterStatus])
  @@index([teacherStatus])
  @@map("book_chapters")
}

model BookChapterStudentAuthor {
  id            String      @id @default(cuid())
  bookChapterId String      @map("book_chapter_id")
  userId        String      @map("user_id")
  bookChapter   BookChapter @relation("studentAuthors", fields: [bookChapterId], references: [id], onDelete: Cascade)
  user          User        @relation("studentAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bookChapterId, userId])
  @@index([userId])
  @@map("book_chapter_student_authors")
}

model BookChapterTeacherAuthor {
  id                    String                      @id @default(cuid())
  bookChapterId         String                      @map("book_chapter_id")
  /// null when faculty is unlisted (not yet a platform user)
  userId                String?                     @map("user_id")
  /// ACCEPTED for registered faculty; PENDING/REJECTED for unlisted faculty
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  bookChapter           BookChapter                 @relation("facultyAuthors", fields: [bookChapterId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("bookChapterVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([bookChapterId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("book_chapter_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// COPYRIGHTS
// ─────────────────────────────────────────────────────────────

model Copyright {
  id               String                   @id @default(cuid())
  regNo            String                   @unique @map("reg_no")
  title            String
  abstract         String?
  imageUrl         String?
  documentUrl      String?
  dateOfFiling     DateTime?
  dateOfSubmission DateTime?
  dateOfPublished  DateTime?
  dateOfGrant      DateTime?
  registrationFees Decimal?                 @db.Decimal(12, 2)
  reimbursement    Decimal?                 @db.Decimal(12, 2)
  copyrightStatus  CopyrightStatus          @default(SUBMITTED)
  teacherStatus    TeacherStatus            @default(UPLOADED)
  isPublic         Boolean                  @default(false)
  updateComment    String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  studentAuthors   CopyrightStudentAuthor[] @relation("studentCopyrightAuthors")
  facultyAuthors   CopyrightTeacherAuthor[] @relation("facultyCopyrightAuthors")
  grantMappings    GrantInMapping[]

  @@index([isPublic, copyrightStatus])
  @@index([teacherStatus])
  @@map("copyrights")
}

model CopyrightStudentAuthor {
  id          String    @id @default(cuid())
  copyrightId String    @map("copyright_id")
  userId      String    @map("user_id")
  copyright   Copyright @relation("studentCopyrightAuthors", fields: [copyrightId], references: [id], onDelete: Cascade)
  user        User      @relation("studentCopyrightAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([copyrightId, userId])
  @@index([userId])
  @@map("copyright_student_authors")
}

model CopyrightTeacherAuthor {
  id                    String                      @id @default(cuid())
  copyrightId           String                      @map("copyright_id")
  userId                String?                     @map("user_id")
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  copyright             Copyright                   @relation("facultyCopyrightAuthors", fields: [copyrightId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyCopyrightAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("copyrightVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([copyrightId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("copyright_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// JOURNALS
// ─────────────────────────────────────────────────────────────

model Journal {
  id               String                 @id @default(cuid())
  serialNo         String                 @unique @map("serial_no")
  title            String
  journalName      String                 @map("journal_name")
  imageUrl         String?
  documentUrl      String?
  abstract         String?
  scope            JournalScope
  reviewType       JournalReviewType
  accessType       JournalAccessType
  indexing         JournalIndexing
  quartile         JournalQuartile        @default(NOT_APPLICABLE)
  impactFactor     Float?
  impactFactorDate DateTime?
  publisher        String?
  publicationMode  JournalPublicationMode
  publicationDate  DateTime?
  doi              String?                @unique
  paperLink        String?
  keywords         String[]
  registrationFees Decimal?               @db.Decimal(12, 2)
  reimbursement    Decimal?               @db.Decimal(12, 2)
  journalStatus    JournalStatus          @default(SUBMITTED)
  teacherStatus    TeacherStatus          @default(UPLOADED)
  isPublic         Boolean                @default(false)
  updateComment    String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  grantMappings    GrantInMapping[]
  studentAuthors   JournalStudentAuthor[] @relation("studentJournalAuthors")
  facultyAuthors   JournalTeacherAuthor[] @relation("facultyJournalAuthors")

  @@index([isPublic, journalStatus])
  @@index([teacherStatus])
  @@map("journals")
}

model JournalStudentAuthor {
  id        String  @id @default(cuid())
  journalId String  @map("journal_id")
  userId    String  @map("user_id")
  journal   Journal @relation("studentJournalAuthors", fields: [journalId], references: [id], onDelete: Cascade)
  user      User    @relation("studentJournalAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([journalId, userId])
  @@index([userId])
  @@map("journal_student_authors")
}

model JournalTeacherAuthor {
  id                    String                      @id @default(cuid())
  journalId             String                      @map("journal_id")
  userId                String?                     @map("user_id")
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  journal               Journal                     @relation("facultyJournalAuthors", fields: [journalId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyJournalAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("journalVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([journalId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("journal_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// PATENTS
// ─────────────────────────────────────────────────────────────

model Patent {
  id              String                @id @default(cuid())
  title           String
  keywords        String[]
  grantedPatentNo String?
  abstract        String?
  imageUrl        String?
  documentUrl     String?
  filingDate      DateTime?
  submissionDate  DateTime?
  publicationDate DateTime?
  grantDate       DateTime?
  applicationNo   String?               @unique
  isPublic        Boolean               @default(false)
  patentLink      String?
  teacherStatus   TeacherStatus         @default(UPLOADED)
  patentStatus    PatentStatus          @default(SUBMITTED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  updateComment   String?
  grantMappings   GrantInMapping[]
  studentAuthors  PatentStudentAuthor[] @relation("studentPatentAuthors")
  facultyAuthors  PatentTeacherAuthor[] @relation("facultyPatentAuthors")

  @@index([isPublic, patentStatus])
  @@index([teacherStatus])
  @@map("patents")
}

model PatentStudentAuthor {
  id       String @id @default(cuid())
  patentId String @map("patent_id")
  userId   String @map("user_id")
  patent   Patent @relation("studentPatentAuthors", fields: [patentId], references: [id], onDelete: Cascade)
  user     User   @relation("studentPatentAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([patentId, userId])
  @@index([userId])
  @@map("patent_student_authors")
}

model PatentTeacherAuthor {
  id                    String                      @id @default(cuid())
  patentId              String                      @map("patent_id")
  userId                String?                     @map("user_id")
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  patent                Patent                      @relation("facultyPatentAuthors", fields: [patentId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyPatentAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("patentVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([patentId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("patent_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// CONFERENCES
// ─────────────────────────────────────────────────────────────

model Conference {
  id                  String                    @id @default(cuid())
  conferenceName      String
  mode                ConferenceMode            @default(OFFLINE)
  abstract            String?
  keywords            String[]
  imageUrl            String?
  documentUrl         String?
  registrationFees    Decimal?                  @db.Decimal(12, 2)
  reimbursement       Decimal?                  @db.Decimal(12, 2)
  isPublic            Boolean                   @default(false)
  teacherStatus       TeacherStatus             @default(UPLOADED)
  conferencePublisher String?
  conferenceDate      DateTime?
  conferenceStatus    ConferenceStatus          @default(SUBMITTED)
  statusDate          DateTime?
  paperDoi            String?                   @unique
  paperLink           String?
  paperName           String?
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  studentAuthors      ConferenceStudentAuthor[] @relation("studentConferenceAuthors")
  facultyAuthors      ConferenceTeacherAuthor[] @relation("facultyConferenceAuthors")
  grantMappings       GrantInMapping[]

  @@index([isPublic, conferenceStatus])
  @@index([teacherStatus])
  @@map("conferences")
}

model ConferenceStudentAuthor {
  id           String     @id @default(cuid())
  conferenceId String     @map("conference_id")
  userId       String     @map("user_id")
  conference   Conference @relation("studentConferenceAuthors", fields: [conferenceId], references: [id], onDelete: Cascade)
  user         User       @relation("studentConferenceAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conferenceId, userId])
  @@index([userId])
  @@map("conference_student_authors")
}

model ConferenceTeacherAuthor {
  id                    String                      @id @default(cuid())
  conferenceId          String                      @map("conference_id")
  userId                String?                     @map("user_id")
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  conference            Conference                  @relation("facultyConferenceAuthors", fields: [conferenceId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyConferenceAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("conferenceVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([conferenceId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("conference_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// GRANTS
// ─────────────────────────────────────────────────────────────

model GrantIn {
  id                  String                 @id @default(cuid())
  projectCode         String?
  grantInStatus       GrantInStatus          @default(APPLIED)
  applicationDate     DateTime?
  grantDate           DateTime?
  /// Free text (e.g. "2 years"). Consider durationMonths Int? if you need to filter/sort.
  durationOfProject   String?
  amountGranted       Decimal?               @db.Decimal(14, 2)
  /// Denormalized total. Update inside the same transaction as bill status changes,
  /// or compute from GrantInBill instead.
  usedAmount          Decimal?               @db.Decimal(14, 2)
  isPublic            Boolean                @default(false)
  hideFromAdmin       Boolean                @default(false)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  bills               GrantInBill[]
  publicationMappings GrantInMapping[]
  studentAuthors      GrantInStudentAuthor[] @relation("studentGrantInAuthors")
  facultyAuthors      GrantInTeacherAuthor[] @relation("facultyGrantInAuthors")

  @@index([isPublic, grantInStatus])
  @@map("grant_ins")
}

model GrantInBill {
  id             String     @id @default(cuid())
  fileId         String     @unique @map("file_id")
  fileUrl        String?    @map("file_url")
  billType       BillType   @default(OTHER) @map("bill_type")
  customBillType String?    @map("custom_bill_type")
  isMasterPdf    Boolean    @default(false) @map("is_master_pdf")
  billStatus     BillStatus @default(PENDING) @map("bill_status")
  billDate       DateTime   @default(now()) @map("bill_date")
  amount         Decimal?   @db.Decimal(12, 2)
  userId         String     @map("user_id")
  grantInId      String     @map("grant_in_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  grantIn        GrantIn    @relation(fields: [grantInId], references: [id], onDelete: Cascade)
  /// Restrict: never cascade-delete financial records when a user is removed
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([grantInId, billStatus])
  @@index([userId])
  @@map("grant_in_bills")
}

/// Exactly one of the five target FKs must be set and must match publicationType.
/// Prisma cannot express CHECK constraints: apply migration_extras.sql after migrating.
model GrantInMapping {
  id              String          @id @default(cuid())
  publicationType PublicationType @map("publication_type")
  grantInId       String          @map("grant_in_id")
  patentId        String?         @map("patent_id")
  journalId       String?         @map("journal_id")
  conferenceId    String?         @map("conference_id")
  bookChapterId   String?         @map("book_chapter_id")
  copyrightId     String?         @map("copyright_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  bookChapter     BookChapter?    @relation(fields: [bookChapterId], references: [id], onDelete: Cascade)
  conference      Conference?     @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  copyright       Copyright?      @relation(fields: [copyrightId], references: [id], onDelete: Cascade)
  grantIn         GrantIn         @relation(fields: [grantInId], references: [id], onDelete: Cascade)
  journal         Journal?        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  patent          Patent?         @relation(fields: [patentId], references: [id], onDelete: Cascade)

  @@unique([grantInId, patentId])
  @@unique([grantInId, journalId])
  @@unique([grantInId, conferenceId])
  @@unique([grantInId, bookChapterId])
  @@unique([grantInId, copyrightId])
  @@index([patentId])
  @@index([journalId])
  @@index([conferenceId])
  @@index([bookChapterId])
  @@index([copyrightId])
  @@map("grant_in_mappings")
}

model GrantInStudentAuthor {
  id        String  @id @default(cuid())
  grantInId String  @map("grant_in_id")
  userId    String  @map("user_id")
  grantIn   GrantIn @relation("studentGrantInAuthors", fields: [grantInId], references: [id], onDelete: Cascade)
  user      User    @relation("studentGrantInAuthors", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([grantInId, userId])
  @@index([userId])
  @@map("grant_in_student_authors")
}

model GrantInTeacherAuthor {
  id                    String                      @id @default(cuid())
  grantInId             String                      @map("grant_in_id")
  userId                String?                     @map("user_id")
  role                  GrantInRole
  verificationStatus    FacultyVerificationStatus   @default(ACCEPTED)
  verificationRequestId String?                     @map("verification_request_id")
  grantIn               GrantIn                     @relation("facultyGrantInAuthors", fields: [grantInId], references: [id], onDelete: Cascade)
  user                  User?                       @relation("facultyGrantInAuthors", fields: [userId], references: [id], onDelete: Restrict)
  verificationRequest   FacultyVerificationRequest? @relation("grantInVerification", fields: [verificationRequestId], references: [id], onDelete: SetNull)

  @@unique([grantInId, userId])
  @@index([userId])
  @@index([verificationRequestId])
  @@map("grant_in_teacher_authors")
}

// ─────────────────────────────────────────────────────────────
// FACULTY VERIFICATION
// ─────────────────────────────────────────────────────────────

/// Single reusable verification request model covering all research types.
model FacultyVerificationRequest {
  id              String                    @id @default(cuid())
  researchType    ResearchType
  /// ID of the related research record. Polymorphic, so there is no FK:
  /// clean up requests when a research record is deleted.
  researchId      String                    @map("research_id")
  facultyName     String                    @map("faculty_name")
  /// Lowercase before write and lookup
  facultyEmail    String                    @map("faculty_email")
  institution     String?
  department      String?
  designation     String?
  orcidId         String?                   @map("orcid_id")
  affiliation     String?
  /// SHA-256 of the single-use token emailed to the faculty. Never store the raw token.
  tokenHash       String                    @unique @map("token_hash")
  tokenExpiry     DateTime                  @map("token_expiry")
  /// true once the faculty has used the link (prevents replay)
  tokenUsed       Boolean                   @default(false) @map("token_used")
  status          FacultyVerificationStatus @default(PENDING)
  rejectionReason String?                   @map("rejection_reason")
  verifiedAt      DateTime?                 @map("verified_at")
  overrideById    String?                   @map("override_by")
  overrideAt      DateTime?                 @map("override_at")
  overrideReason  String?                   @map("override_reason")
  requestedById   String                    @map("requested_by_id")
  /// Populated when the faculty registers/links their account later
  linkedFacultyId String?                   @map("linked_faculty_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  linkedFaculty   User?                     @relation("linkedVerifications", fields: [linkedFacultyId], references: [id], onDelete: SetNull)
  overriddenBy    User?                     @relation("verificationOverrides", fields: [overrideById], references: [id], onDelete: SetNull)
  requestedBy     User                      @relation("verificationRequests", fields: [requestedById], references: [id], onDelete: Restrict)

  bookChapterAuthors BookChapterTeacherAuthor[] @relation("bookChapterVerification")
  copyrightAuthors   CopyrightTeacherAuthor[]   @relation("copyrightVerification")
  journalAuthors     JournalTeacherAuthor[]     @relation("journalVerification")
  patentAuthors      PatentTeacherAuthor[]      @relation("patentVerification")
  conferenceAuthors  ConferenceTeacherAuthor[]  @relation("conferenceVerification")
  grantInAuthors     GrantInTeacherAuthor[]     @relation("grantInVerification")

  @@index([researchType, researchId])
  @@index([facultyEmail])
  @@index([status])
  @@index([requestedById])
  @@index([linkedFacultyId])
  @@index([overrideById])
  @@index([tokenExpiry])
  @@map("faculty_verification_requests")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATES, FDP, ACHIEVEMENTS
// ─────────────────────────────────────────────────────────────

model Certificate {
  id                String            @id @default(cuid())
  title             String
  description       String?
  keywords          String[]
  documentUrl       String?
  offeredBy         String?
  dateOfCompletion  DateTime
  remark            String?
  isPublic          Boolean           @default(true)
  userId            String            @map("user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  certificateStatus CertificateStatus @default(SUBMITTED)
  updateComment     String?
  user              User              @relation("userCertificates", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic, certificateStatus])
  @@map("certificates")
}

model FDP {
  id            String    @id @default(cuid())
  title         String
  description   String?
  keywords      String[]
  organizedBy   String?
  startDate     DateTime?
  endDate       DateTime?
  topic         String?
  duration      String?
  remark        String?
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  isPublic      Boolean   @default(false)
  fdpStatus     FDPStatus @default(SUBMITTED)
  updateComment String?
  user          User      @relation("userFDPs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic, fdpStatus])
  @@map("fdps")
}

model Achievement {
  id                String            @id @default(cuid())
  title             String
  description       String
  category          String?
  year              Int
  imageUrl          String?
  documentUrl       String?
  achievementStatus AchievementStatus @default(SUBMITTED)
  isPublic          Boolean           @default(false)
  updateComment     String?
  userId            String            @map("user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  user              User              @relation("userAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic, achievementStatus])
  @@map("achievements")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS & EVENTS
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  /// Consider converting to an enum once the set of types is stable
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Event {
  id               String      @id @default(cuid())
  name             String
  posterUrl        String?
  registrationCost Decimal?    @db.Decimal(12, 2)
  description      String
  registrationLink String
  contactName      String
  contactPhone     String
  eventDate        DateTime
  /// Lifecycle status: DRAFT until an editor/admin publishes it
  eventStatus      EventStatus @default(DRAFT)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([eventStatus, eventDate])
  @@map("events")
}

